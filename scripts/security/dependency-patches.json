      "edits": null,
      "content": "'use strict';\n// Iterative traversal ignores parent/prev links. Limit depth before recursive walkers run.\nmodule.exports = ast => {\n  const pending = [[ast, 0]];\n  const seen = new Set();\n  let count = 0;\n  while (pending.length) {\n    const [node, depth] = pending.pop();\n    if (!node || typeof node !== 'object') continue;\n    if (depth > 64 || seen.has(node) || ++count > 100000) {\n      throw new RangeError('Brace AST exceeds safe traversal limits');\n    }\n    seen.add(node);\n    if (Array.isArray(node.nodes)) {\n      for (const child of node.nodes) pending.push([child, depth + 1]);\n    }\n  }\n};\n"
    },
